filters:
  and:
    - 'type == "reference"'
    - 'category == "theory"'

properties:
  file.name:
    displayName: Title
  authors:
    displayName: Authors
  year:
    displayName: Year
  journal:
    displayName: Journal

views:
  - type: table
    name: Theory & Frameworks
    order:
      - file.name
      - authors
      - year
      - journal
