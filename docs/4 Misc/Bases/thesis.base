filters:
  and:
    - section == "thesis"
properties:
  file.name:
    displayName: Note
  file.mtime:
    displayName: Modified
views:
  - type: table
    name: Thesis Chapters
    order:
      - file.name
      - file.mtime
    rowHeight: medium
  - type: cards
    name: View
    imageAspectRatio: 0.45
    cardSize: 200
