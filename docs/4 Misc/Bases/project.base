filters:
  and:
    - section == "project"
properties:
  file.name:
    displayName: Document
  file.mtime:
    displayName: Last Updated
  file.ctime:
    displayName: Created
views:
  - type: cards
    name: Project Management
    order:
      - file.name
      - file.mtime
    indentProperties: true
    imageAspectRatio: 1.6
    imageFit: contain
    cardSize: 220
